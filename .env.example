# Copiez ce fichier en .env puis remplissez-le :  cp .env.example .env

# --- Infrastructure ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-moi
# Générez une clé : openssl rand -hex 32  (ne la changez plus ensuite)
N8N_ENCRYPTION_KEY=
TZ=Africa/Dakar

# --- Vous ---
CANDIDATE_NAME="Prénom Nom"
CANDIDATE_EMAIL=vous@example.com

# --- Recherche ---
# Mots-clés (séparés par des virgules) cherchés dans le titre et les tags des offres
SEARCH_KEYWORDS="backend,node,typescript,devops,full stack"
# Offres à écarter si le titre contient l'un de ces mots
EXCLUDE_KEYWORDS="intern,stagiaire,principal"
# On ignore les offres publiées il y a plus de N jours
MAX_AGE_DAYS=14
# Nombre max d'offres analysées par Claude à chaque passage (contrôle des coûts)
MAX_OFFERS_PER_RUN=15
# Score minimum (0-100) pour qu'une offre vous soit proposée sur Telegram
MIN_SCORE=70

# --- Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Telegram (bot créé via @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Votre chat id : envoyez un message à votre bot puis ouvrez
# https://api.telegram.org/bot<TOKEN>/getUpdates  -> message.chat.id
TELEGRAM_CHAT_ID=

# --- Envoi des candidatures par email (SMTP) ---
# Gmail : smtp.gmail.com / 465 / mot de passe d'application (pas votre mot de passe)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=vous@gmail.com
SMTP_PASSWORD=
