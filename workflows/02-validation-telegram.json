{
  "id": "jobValidate00001",
  "name": "2 · Mes décisions Telegram → envoi de la candidature",
  "active": false,
  "nodes": [
    {
      "id": "node-0026",
      "name": "Chaque minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "node-0027",
      "name": "Lancer maintenant",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        500
      ],
      "parameters": {}
    },
    {
      "id": "node-0028",
      "name": "Lire l’offset Telegram",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT value::bigint AS next_offset FROM bot_state WHERE key = 'telegram_offset';",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "jobsPgCred000001",
          "name": "Postgres (jobs)"
        }
      }
    },
    {
      "id": "node-0029",
      "name": "Lire mes clics Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "url": "={{ ($env.TELEGRAM_API_URL || 'https://api.telegram.org') + '/bot' + $env.TELEGRAM_BOT_TOKEN + '/getUpdates' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "offset",
              "value": "={{ $json.next_offset }}"
            },
            {
              "name": "timeout",
              "value": "0"
            },
            {
              "name": "allowed_updates",
              "value": "[\"callback_query\"]"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      }
    },
    {
      "id": "node-0025",
      "name": "Extraire les décisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "  // Polling Telegram : pas besoin d'URL publique ni de tunnel.\n  const updates = $input.first().json.result || [];\n  if (!updates.length) return [];\n  const next_offset = Math.max(...updates.map((u) => u.update_id)) + 1;\n  const myChat = String($env.TELEGRAM_CHAT_ID);\n  const out = [];\n  for (const u of updates) {\n    const q = u.callback_query;\n    if (!q || String(q.message?.chat?.id) !== myChat) continue; // seuls VOS clics comptent\n    const [action, rawId] = String(q.data || '').split(':');\n    if (!['apply', 'reject'].includes(action) || !/^\\d+$/.test(rawId)) continue;\n    out.push({\n      json: {\n        action,\n        offer_id: Number(rawId),\n        message_id: q.message.message_id,\n        original_text: String(q.message.text || '').slice(0, 3700),\n        next_offset,\n      },\n    });\n  }\n  // Toujours renvoyer au moins un item pour mémoriser l'offset\n  return out.length ? out : [{ json: { action: 'none', next_offset } }];\n"
      }
    },
    {
      "id": "node-0030",
      "name": "Mémoriser l’offset",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        900,
        120
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE bot_state SET value = $1 WHERE key = 'telegram_offset';",
        "options": {
          "queryReplacement": "={{ [String($json.next_offset)] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "jobsPgCred000001",
          "name": "Postgres (jobs)"
        }
      },
      "executeOnce": true
    },
    {
      "id": "node-0033",
      "name": "Décision",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        900,
        400
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "node-0031",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "apply",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Postuler"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "node-0032",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "reject",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Rejeter"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-0034",
      "name": "Marquer rejetée",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1140,
        620
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE offers SET status = 'rejected', decided_at = now()\nWHERE id = $1::int AND status = 'pending_review'\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [$json.offer_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "jobsPgCred000001",
          "name": "Postgres (jobs)"
        }
      }
    },
    {
      "id": "node-0035",
      "name": "Texte : rejetée",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1380,
        620
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "    return $input.all().map((i, idx) => {\n      const d = $('Extraire les décisions').itemMatching(idx).json;\n      return { json: { message_id: d.message_id, text: `${d.original_text}\\n\\n❌ REJETÉE` } };\n    });\n"
      }
    },
    {
      "id": "node-0036",
      "name": "Verrouiller la décision",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1140,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE offers SET status = 'approved', decided_at = now()\nWHERE id = $1::int AND status = 'pending_review'\nRETURNING id, title, company, url, apply_url, contact_email, email_subject, cover_letter,\n          analysis->>'langue_offre' AS langue;",
        "options": {
          "queryReplacement": "={{ [$json.offer_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "jobsPgCred000001",
          "name": "Postgres (jobs)"
        }
      }
    },
    {
      "id": "node-0041",
      "name": "Email de contact ?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1380,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "node-0037",
                    "leftValue": "={{ $json.id }}",
                    "rightValue": "",
                    "operator": {
                      "type": "number",
                      "operation": "exists",
                      "singleValue": true
                    }
                  },
                  {
                    "id": "node-0038",
                    "leftValue": "={{ $json.contact_email }}",
                    "rightValue": "",
                    "operator": {
                      "type": "string",
                      "operation": "notEmpty",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Email"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "node-0039",
                    "leftValue": "={{ $json.id }}",
                    "rightValue": "",
                    "operator": {
                      "type": "number",
                      "operation": "exists",
                      "singleValue": true
                    }
                  },
                  {
                    "id": "node-0040",
                    "leftValue": "={{ $json.contact_email }}",
                    "rightValue": "",
                    "operator": {
                      "type": "string",
                      "operation": "empty",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Formulaire"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-0042",
      "name": "Lire mon CV",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1620,
        200
      ],
      "parameters": {
        "fileSelector": "={{ /fran|french/i.test($json.langue || '') ? '/files/profile/cv-fr.pdf' : '/files/profile/cv.pdf' }}",
        "options": {}
