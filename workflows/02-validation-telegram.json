        "jsCode": "    return $input.all().map((i, idx) => {\n      const d = $('Extraire les décisions').itemMatching(idx).json;\n      return { json: { message_id: d.message_id, text: `${d.original_text}\\n\\n✅ CANDIDATURE ENVOYÉE à ${i.json.contact_email}` } };\n    });\n"
      }
