        "operation": "editMessageText",
        "messageType": "message",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "messageId": "={{ $json.message_id }}",
        "text": "={{ $json.text }}",
        "replyMarkup": "none",
        "additionalFields": {
